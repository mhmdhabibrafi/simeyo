[Unit]
Description=Simeyo private database media and key backup
OnFailure=simeyo-maintenance-alert@%n.service
[Service]
Type=oneshot
User=mediasi
WorkingDirectory=/srv/simeyo/app
UMask=0077
ExecStart=/usr/bin/python3 /srv/simeyo/app/infrastructure/scripts/server-maintenance.py backup
TimeoutStartSec=30min
Nice=10
