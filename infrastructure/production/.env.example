# Copy to an ignored .env.production. Never reuse CI or demo credentials.
SITE_HOST=campus.example
PUBLIC_TLS_PORT=443
# Optional separate loopback port when Cloudflare Tunnel owns public HTTPS.
GATEWAY_BIND_PORT=18443
PUBLIC_ORIGIN=https://campus.example
STATEFUL_DOMAIN=campus.example
IMAGE_TAG=release-candidate
SIMEYO_PRODUCTION_ENV_FILE=.env.production
APP_KEY=
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=verify-full
# Mount the provider CA into the container and supply its container path.
DB_SSLROOTCERT=
DB_JIT=off
REVERB_APP_KEY=
REVERB_APP_SECRET=
TLS_CERT_FILE=/private/tls/fullchain.pem
TLS_KEY_FILE=/private/tls/privkey.pem
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Simeyo
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
